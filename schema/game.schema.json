{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DLE Games proposed community entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "url", "category", "summary", "daily"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "category": {
      "type": "string",
      "enum": ["word", "geography", "logic", "music", "movies", "sports", "trivia", "other"]
    },
    "summary": { "type": "string", "minLength": 15, "maxLength": 700 },
    "daily": { "type": "boolean" },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    }
  }
}
